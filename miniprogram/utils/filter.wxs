/**
 * utils/filter.wxs
 * ============================================================================
 * 【职责】WXS 过滤器：数组 indexOf
 * 【依赖】无（WXS 模块，供 WXML 引入）
 * 【注意事项】WXS 内不能调用小程序 JS 模块，仅可做纯计算
 * ============================================================================
 */
/*
 * 需要使用的方法
 */
var indexOf = function indexOf(array, item) {

  
  // 2. 空数组直接返回-1（已有逻辑保留）
  if (array.length === 0) {
    return -1;
  }
  
  // 3. 执行查找
  return array.indexOf(item);
}

/*
* 导出方法：左边的filter.wxs中的方法名，右边是页面引入的方法名
*/
module.exports = {
  indexOf: indexOf
}
